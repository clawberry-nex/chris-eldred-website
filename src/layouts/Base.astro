---
import '../styles/global.css';
import site from '../data/site.yaml';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://chriseldred.co.uk/" />
  <meta property="og:image" content="https://chriseldred.co.uk/photos/03-hero.jpeg" />
  <meta name="theme-color" content="#0C0907" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Video player">
    <button class="lb-close" type="button" aria-label="Close video">Close ✕</button>
    <div class="lb-inner"></div>
  </div>

  <script>
    import '../scripts/client.ts';
  </script>
</body>
</html>
